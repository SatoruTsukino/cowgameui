--[[
	Line icons from the wireframe's 24×24 SVGs (stroke-2, round caps), drawn with plain Frames so they scale crisply
	with the HUD's UIScale (no image assets, no emoji, no glyphs missing from Nunito).

	Outlines come from IconData, generated by tools/gen-icons.mjs from the <svg data-icon> elements in index.html.
	To change an icon, edit its SVG in index.html and run `node tools/gen-icons.mjs`.

	Icons.draw(name, parent, size, color, weight?) -> Frame
	  name    one of the keys in IconData
	  size    icon box in virtual px (w-4 = 16, w-5 = 20, w-6 = 24)
	  color   Theme token (live re-theming) or Color3
	  weight  stroke width in SVG units (default 2.25)
]]

local CowHUD = script.Parent
local IconData = require(CowHUD.IconData)
local Theme = require(CowHUD.Theme)
local Util = require(CowHUD.Util)

local Icons = {}

function Icons.draw(name: string, parent: Instance, size: number, color: any, weight: number?): Frame
	local polylines = IconData[name]
	assert(polylines, "unknown icon " .. name)
	local unit = size / 24
	local thickness = (weight or 2.25) * unit
	local icon = Util.frame({
		Name = "Icon",
		Size = UDim2.fromOffset(size, size),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 2,
		Parent = parent,
	})

	-- One round-capped Frame per segment; + thickness so the caps overlap at joints.
	local function stroke(x1: number, y1: number, x2: number, y2: number)
		local dx, dy = (x2 - x1) * unit, (y2 - y1) * unit
		local frame = Util.frame({
			Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + thickness, thickness),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((x1 + x2) / 2 * unit, (y1 + y2) / 2 * unit),
			Rotation = math.deg(math.atan2(dy, dx)),
			BackgroundColor3 = color,
			Parent = icon,
		})
		Util.corner(frame, "full")
	end

	for _, points in polylines do
		if #points == 2 then
			stroke(points[1], points[2], points[1], points[2]) -- a dot: one cap-sized circle
		end
		for i = 1, #points - 3, 2 do
			stroke(points[i], points[i + 1], points[i + 2], points[i + 3])
		end
	end
	return icon
end

-- Re-colours a drawn icon (e.g. selected vs idle catalog slot) with a Theme token.
function Icons.paint(icon: Frame, color: Theme.Token)
	for _, stroke in icon:GetChildren() do
		if stroke:IsA("GuiObject") then
			Theme.paint(stroke, "BackgroundColor3", color)
		end
	end
end

-- Fixed-size, list-friendly slot holding an icon (for UIListLayout rows).
function Icons.slot(name: string, parent: Instance, size: number, color: any, order: number?): Frame
	local holder = Util.frame({ Name = name, Size = UDim2.fromOffset(size, size), LayoutOrder = order, Parent = parent })
	Icons.draw(name, holder, size, color)
	return holder
end

return Icons
